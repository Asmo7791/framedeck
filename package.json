{
  "name": "framedeck",
  "version": "0.3.0",
  "description": "Design your own dashboard screens for any display: monitors, tablets, round cooler LCDs and more",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . FrameDeck --platform=darwin --arch=arm64,x64 --out=dist --overwrite --icon=build/icon.icns --app-bundle-id=com.kaitungyu.framedeck --app-category-type=public.app-category.utilities --ignore=^/dist --ignore=^/build/src",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never -c.mac.identity=-",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "check": "node tools/check.mjs",
    "i18n": "node tools/make-zh-hant.mjs"
  },
  "author": {
    "name": "Kai-Tung Yu",
    "email": "124535894+Asmo7791@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "opencc-js": "^1.0.5",
    "png2icons": "^2.0.1",
    "resedit": "^3.1.0"
  },
  "productName": "FrameDeck",
  "homepage": "https://github.com/Asmo7791/framedeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asmo7791/framedeck.git"
  },
  "bugs": {
    "url": "https://github.com/Asmo7791/framedeck/issues"
  },
  "keywords": [
    "dashboard",
    "electron",
    "widgets",
    "nzxt",
    "kraken",
    "kiosk",
    "raspberry-pi",
    "e-ink"
  ],
  "build": {
    "appId": "com.kaitungyu.framedeck",
    "productName": "FrameDeck",
    "copyright": "Copyright © 2026 Kai-Tung Yu",
    "files": [
      "src/**",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "FrameDeck reads what Spotify or Music is playing for the Now playing widget.",
        "NSLocalNetworkUsageDescription": "FrameDeck shares your screens with tablets, phones and other computers on your network when you turn on network sharing."
      },
      "notarize": true,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "FrameDeck ${version}",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FrameDeck",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "framedeck",
      "synopsis": "Dashboard screens for any display",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "Kai-Tung Yu <124535894+Asmo7791@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
